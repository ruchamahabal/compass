 "client_script": "frappe.web_form.after_load = () => {\n    frappe.web_form.set_value(\"customer\", frappe.session.user)\n}\n\nfrappe.web_form.on(\"tour_package\", (field, value) => {\n    frappe.call({\n\t\tmethod: \"frappe.client.get_value\",\n\t\targs: {\n\t\t\tdoctype: \"Tour Package\",\n\t\t\tfieldname: [\"price\", \"duration_in_days\"],\n\t\t\tfilters: { name: value },\n\t\t},\n\t\tcallback: function(r) {\n\t\t\tif (r.message) {\n\t\t\t\tlet package = r.message\n\t\t\t\tfrappe.web_form.set_values({\n            ...package\n        })\n\t\t\t}\n\t\t}\n\t});\n})\n\nfrappe.web_form.on(\"number_of_travellers\", (field, value) => {\n    let amount = frappe.web_form.get_value(\"price\") * value\n    frappe.web_form.set_value(\"total_amount\", amount)\n})",
